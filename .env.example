# Copy to backend/.env and fill in. Never commit real keys or passwords.

# AI Analyst provider: groq (default) or anthropic. Without a key it runs in Demo Mode.
LLM_PROVIDER=groq
# Groq API key from https://console.groq.com/keys (starts with gsk_)
GROQ_API_KEY=your_groq_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Anthropic API key (only used when LLM_PROVIDER=anthropic).
ANTHROPIC_API_KEY=your_key_here
# Claude model used to explain computed results.
RIQ_LLM_MODEL=claude-opus-5-5

# Storage: MongoDB is the database of record (RIQ_STORAGE=file keeps everything in local files; used by tests).
RIQ_STORAGE=mongodb
# Connection string. Local MongoDB Community Server: mongodb://127.0.0.1:27017
# MongoDB Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# (URL-encode special characters in the password: @ -> %40, : -> %3A, / -> %2F, # -> %23)
RIQ_MONGO_URI=mongodb://127.0.0.1:27017
RIQ_MONGO_DB=restaurantiq
# How long to wait for MongoDB before reporting it as unreachable (milliseconds).
RIQ_MONGO_TIMEOUT_MS=5000

# Optional: folder for raw uploaded files (raw files stay byte-identical on disk; MongoDB stores their checksum).
# RIQ_DATA_DIR=C:\path\to\restaurantiq-data

# Authentication. JWT_SECRET signs session tokens: keep it private, at least 32 characters.
# Generate a new one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-generate-a-long-random-secret
JWT_EXPIRE_MINUTES=60
ALLOW_REGISTRATION=true
# Optional demo account, created on first startup (use a normal address such as demo@example.com).
# If set, accounts created before login existed (your earlier datasets) go to the demo account.
DEMO_USER_EMAIL=
DEMO_USER_PASSWORD=
# development | production (production refuses to start without a strong JWT_SECRET)
RIQ_ENV=development
# Set true when the app is served over HTTPS
COOKIE_SECURE=false
