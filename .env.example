# Copy to backend/.env and fill in. Never commit real keys.

# Optional: enables live AI explanations in the AI Analyst (otherwise Demo Mode).
ANTHROPIC_API_KEY=

# Optional: Claude model used to explain computed results.
RIQ_LLM_MODEL=claude-opus-5-5

# Optional: storage folder for raw uploads, dataset versions and settings.
# RIQ_DATA_DIR=C:\path\to\restaurantiq-data
